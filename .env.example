# Copy to .env (gitignored). Set the key(s) for each provider your config uses; all calls go through LiteLLM.
# Several keys per provider: add _2 ... _9 (or one comma-separated *_API_KEYS line). A key that is invalid,
# expired or out of daily quota is dropped for the run; a rate-limited key rests while the next one is used.
OPENROUTER_API_KEY=
GEMINI_API_KEY=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
